# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' mailto: https://formspree.io https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Fingerprinted build assets never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind index is rebuilt on every deploy with stable file names for the entry points.
/pagefind/*
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og-default.jpg
  Cache-Control: public, max-age=604800
