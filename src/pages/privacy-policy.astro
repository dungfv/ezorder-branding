<LegalLayout
  title="Privacy Policy"
  description="How EZ Order Printer — PDF Invoice handles merchant, store and buyer information."
  lead="How EZ Order Printer — PDF Invoice handles merchant, store and buyer information."
  lastUpdated="22 August 2026"
>
  <nav
    aria-labelledby="toc-heading"
    class="not-prose mb-12 rounded-xl border border-line bg-surface p-5 sm:p-6"
  >
    <h2 id="toc-heading" class="eyebrow">On this page</h2>
    <ol class="mt-4 list-decimal space-y-1.5 pl-5 text-base marker:text-muted sm:columns-2 sm:gap-8">
      {
        sections.map((s) => (
          <li class="break-inside-avoid">
            <a href={`#${s.id}`} class="text-accent underline-offset-4 hover:underline">
