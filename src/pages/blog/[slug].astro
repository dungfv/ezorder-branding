---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPublishedPosts, getRelatedPosts, type BlogPost } from '../../lib/blog-posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  // A numeric slug would shadow a pagination page (/blog/2/).
  const numeric = posts.find((post) => /^\d+$/.test(post.id));
  if (numeric) throw new Error(`Blog post "${numeric.id}" needs a non-numeric file name.`);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: getRelatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
  related: BlogPost[];
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout post={post} headings={headings} related={related}>
  <Content />
</BlogPostLayout>
