---
/**
 * Contact form. Delivery is configured in `data/contact-form.ts`.
 *
 * mailto mode: without JS the browser posts the form to a `mailto:` URL
 * (text/plain). With JS, a small inline script builds a clean mailto link
 * (subject + body) instead, which every email client understands.
 * Other providers: a regular POST to the provider endpoint, with a honeypot field.
 */
import { contactForm } from '../../data/contact-form';
import { site } from '../../data/site';

const { provider, endpoint, web3formsAccessKey } = contactForm;
const isMailto = provider === 'mailto';

const action = isMailto
  ? `mailto:${site.supportEmail}`
  : provider === 'web3forms'
    ? 'https://api.web3forms.com/submit'
    : endpoint;

const fieldClass =
  'mt-1.5 block w-full rounded-xl border border-line-strong bg-bg px-3.5 py-2.5 text-fg placeholder:text-muted/70 focus:border-accent';
---

<form
  action={action}
  method="post"
  enctype={isMailto ? 'text/plain' : undefined}
  class="space-y-5"
  data-contact-form={isMailto ? 'mailto' : provider}
  data-mailto={isMailto ? site.supportEmail : undefined}
>
  {provider === 'web3forms' && <input type="hidden" name="access_key" value={web3formsAccessKey} />}
  {
    !isMailto && (
      <input
        type="checkbox"
        name={provider === 'formspree' ? '_gotcha' : 'botcheck'}
        class="hidden"
        tabindex="-1"
        autocomplete="off"
      />
    )
  }

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block text-sm font-medium">
      Name
      <input name="name" type="text" required autocomplete="name" class={fieldClass} />
    </label>
    <label class="block text-sm font-medium">
      Email
      <input name="email" type="email" required autocomplete="email" class={fieldClass} />
    </label>
  </div>
  <label class="block text-sm font-medium">
    Store URL <span class="font-normal text-muted">(optional)</span>
    <input
      name="store"
      type="text"
      inputmode="url"
      placeholder="your-store.myshopify.com"
      class={fieldClass}
    />
  </label>
  <label class="block text-sm font-medium">
    Message
    <textarea name="message" rows="5" required maxlength="1500" class={fieldClass}></textarea>
  </label>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <button
      type="submit"
      class="inline-flex h-12 shrink-0 items-center justify-center rounded-full bg-mint px-6 font-semibold whitespace-nowrap text-on-mint transition-colors hover:bg-mint-strong"
    >
      Send message
    </button>
    {
      isMailto && (
        <p class="text-sm text-muted">
          Opens your email app. Prefer to write directly?{' '}
          <a class="font-medium text-accent underline underline-offset-4" href={`mailto:${site.supportEmail}`}>
            {site.supportEmail}
          </a>
        </p>
      )
    }
  </div>
</form>

<script is:inline>
  (() => {
    const form = document.querySelector('form[data-contact-form="mailto"]');
    if (!form) return;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const subject = `Website enquiry from ${data.get('name')}`;
      const lines = [String(data.get('message') ?? ''), '', `Name: ${data.get('name')}`, `Email: ${data.get('email')}`];
      if (data.get('store')) lines.push(`Store: ${data.get('store')}`);
      const body = lines.join('\n');
      window.location.href =
        `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  })();
</script>
