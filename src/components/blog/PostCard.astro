---
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { formatDate, postUrl, readingTime, type BlogPost } from '../../lib/blog-posts';

interface Props {
  post: BlogPost;
  /** Heading level for the title (h2 on listings, h3 inside "related posts"). */
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const { title, description, pubDate, cover, tags } = post.data;
const Heading = headingLevel;
---

<article class="group relative flex flex-col overflow-hidden rounded-(--radius-card) border border-line bg-surface transition-colors hover:border-line-strong">
  {
    cover && (
      <div class="aspect-[1200/630] overflow-hidden border-b border-line bg-surface-muted">
        <Picture
          src={cover.src}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
          alt={cover.alt}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    {tags[0] && <p class="eyebrow">{tags[0]}</p>}
    <Heading class="mt-2 text-xl leading-snug font-bold">
      <a href={postUrl(post)} class="after:absolute after:inset-0">{title}</a>
    </Heading>
    <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-muted">{description}</p>
    <p class="mt-5 flex items-center gap-4 text-xs text-muted">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar" size={14} />
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="clock" size={14} />
        {readingTime(post.body)} min read
      </span>
    </p>
  </div>
</article>
