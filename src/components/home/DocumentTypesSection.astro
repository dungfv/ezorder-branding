---
/**
 * Document types gallery (real renders) + the template library overview.
 */
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { documentTypes } from '../../data/features';
import { getScreenshot } from '../../lib/document-screenshots';

const withImage = documentTypes.filter((doc) => doc.image);
const withoutImage = documentTypes.filter((doc) => !doc.image);
---

<section id="documents" aria-labelledby="documents-title" class="mt-24 bg-surface-muted py-20 sm:mt-32 sm:py-28">
  <div class="container-page">
    <SectionHeading
      id="documents-title"
      eyebrow="02 · Documents"
      title="Every document an order needs, on one brand"
      lead="Set your logo, colours and company details once. Invoices, packing slips, refunds and quotes all follow — each with the fields that document actually needs."
    />

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        withImage.map((doc) => (
          <li class="flex flex-col">
            <figure class="group">
              <div class="doc-frame aspect-[3/4] transition-transform duration-300 group-hover:-translate-y-1">
                <Picture
                  src={getScreenshot(doc.image!)}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 480, 640]}
                  sizes="(min-width: 1024px) 270px, (min-width: 640px) 45vw, 90vw"
                  alt={`Sample ${doc.name.toLowerCase()} generated by EZ Order Printer`}
                  class="h-full w-full object-cover object-top"
                />
              </div>
              <figcaption class="mt-4">
                <span class="flex items-center gap-2 font-display text-lg font-bold">
                  <Icon name={doc.icon} size={18} class="text-accent" />
                  {doc.name}
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-muted">{doc.summary}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    {
      withoutImage.map((doc) => (
        <p class="mt-8 flex items-start gap-3 rounded-2xl border border-line bg-surface p-5 text-sm leading-relaxed text-muted">
          <Icon name={doc.icon} size={20} class="mt-0.5 shrink-0 text-accent" />
          <span>
            <strong class="text-fg">Plus {doc.name.toLowerCase()}s.</strong> {doc.summary}
          </span>
        </p>
      ))
    }

    <div class="mt-16 grid items-end gap-6 lg:grid-cols-[1fr_2fr]">
      <div>
        <h3 class="text-2xl font-bold">14 templates, built for real stores</h3>
        <p class="mt-3 leading-relaxed text-muted">
          Fashion, homeware, wholesale, food, electronics, services. Pick a design, drop in your logo
          and colours — or send us a layout and we'll build it for you.
        </p>
      </div>
      <!-- Wide overview scrolls inside its own frame on small screens; the page never scrolls sideways. -->
      <div class="doc-frame overflow-x-auto" tabindex="0" aria-label="Template library preview (scrollable)">
        <Picture
          src={getScreenshot('template-gallery')}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[800, 1200, 1800]}
          sizes="(min-width: 1024px) 760px, 900px"
          alt="The EZ Order Printer template library: Carbon, Silver, Gold, Copper, Neon, Zinc, Oxygen, Titanium, Silicon, Helium, Iron, Platinum, Hydrogen and Nickel invoice designs"
          class="h-auto w-[56rem] max-w-none lg:w-full lg:max-w-full"
        />
      </div>
    </div>
  </div>
</section>
