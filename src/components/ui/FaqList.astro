---
/**
 * Accessible FAQ built on native <details>/<summary> (keyboard and screen
 * reader support for free, no JavaScript). Pair with faqPageSchema() for JSON-LD.
 */
import Icon from './Icon.astro';

interface Props {
  items: { question: string; answer: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={['divide-y divide-line border-y border-line', className]}>
  {
    items.map((item) => (
      <details class="group py-1">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-left font-semibold [&::-webkit-details-marker]:hidden">
          <span>{item.question}</span>
          <span class="grid size-8 shrink-0 place-items-center rounded-full border border-line text-muted transition-transform duration-200 group-open:rotate-45">
            <Icon name="plus" size={16} strokeWidth={2} />
          </span>
        </summary>
        <p class="pr-12 pb-5 leading-relaxed text-muted">{item.answer}</p>
      </details>
    ))
  }
</div>
