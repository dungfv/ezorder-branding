---
/** Section intro: receipt-style eyebrow, h2 and optional lead paragraph. */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  id?: string;
  class?: string;
}

const { eyebrow, title, lead, align = 'left', id, class: className } = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl', className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="mt-3 text-3xl leading-[1.1] font-bold sm:text-4xl lg:text-[2.75rem]">
    {title}
  </h2>
  {lead && <p class="mt-4 text-lg leading-relaxed text-muted">{lead}</p>}
</div>
