---
/**
 * Crisp live chat, consent-gated under "functional" (it sets crisp-client/* cookies):
 * nothing is requested from Crisp until the visitor allows it (components/consent/).
 * [data-open-chat] links open the chat; without consent they open Cookie settings first
 * and the chat opens as soon as "Functional" is allowed.
 * Its domains are allowed in the CloudFront CSP (infra/cloudformation-website-hosting.yml).
 */
const CRISP_WEBSITE_ID = '481ec1eb-32ab-417f-bc00-11c6a40abbcd';
---

<script is:inline define:vars={{ CRISP_WEBSITE_ID }}>
  (() => {
    const consent = window.siteConsent;
    let loaded = false;
    let openWhenReady = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      window.$crisp = window.$crisp || [];
      window.CRISP_WEBSITE_ID = CRISP_WEBSITE_ID;
      const s = document.createElement('script');
      s.src = 'https://client.crisp.chat/l.js';
      s.async = true;
      document.head.appendChild(s);
      if (openWhenReady) window.$crisp.push(['do', 'chat:open']);
    };

    consent.on('functional', load);

    document.addEventListener('click', (e) => {
      const trigger = e.target instanceof Element && e.target.closest('[data-open-chat]');
      if (!trigger) return;
      e.preventDefault();
      openWhenReady = true;
      if (consent.has('functional')) {
        load();
        window.$crisp.push(['do', 'chat:open']);
      } else {
        document.dispatchEvent(new CustomEvent('consent:open'));
      }
    });
  })();
</script>
