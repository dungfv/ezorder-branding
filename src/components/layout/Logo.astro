---
/**
 * EZ Order Printer logo: the app's "EZ" monogram (vector-traced from
 * `app/frontend/public/logo_large.png` in the app repo) plus a text wordmark.
 */
interface Props {
  /** Render the monogram only (no wordmark). */
  markOnly?: boolean;
  size?: number;
  class?: string;
}

const { markOnly = false, size = 32, class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1200 1200"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
    class="shrink-0"
  >
    <rect width="1200" height="1200" rx="264" fill="#022515"></rect>
    <g transform="translate(0,1200) scale(0.1,-0.1)" fill="#fff">
      <path
        d="M3127 9689c-390-51-728-370-801-758-24-127-24-5761 0-5878 72-348 332-618 694-720 57-16 108-18 435-18l370 0 2 430c2 485 2 485 78 590 23 33 117 153 207 266l165 207-36 6c-20 3-179 6-353 6l-318 0 0 980 0 980 1110 0 1110 0 72 88c71 87 147 180 415 513 73 90 209 259 302 374l169 210-1589 3-1589 2 0 765 0 765 2466 0c1969 0 2464-3 2458-12-8-13-302-378-592-737-79-97-257-318-396-491-139-173-311-387-382-474-153-189-547-679-1020-1267-187-233-465-579-618-769-153-190-409-509-570-710-162-201-373-464-471-585-98-121-184-234-191-252-11-26-14-121-14-463l0-430 2438 2c2342 3 2439 4 2487 21 219 81 361 207 449 398 63 136 71 198 71 519l0 285-1787 5-1788 5 123 155c67 85 197 247 288 360 91 113 225 279 298 370 73 91 195 241 270 334 441 546 859 1065 1507 1871 691 860 835 1039 926 1150 163 200 173 242 165 760-5 370-11 418-68 565-86 222-305 440-528 525-173 65 104 59-3046 61-1606 1-2880-2-2918-7z"
      ></path>
    </g>
  </svg>
  {
    !markOnly && (
      <span class="font-display text-[1.0625rem] leading-none font-bold tracking-tight">
        EZ Order<span class="font-medium text-muted"> Printer</span>
      </span>
    )
  }
</span>
